# Copy to `.env.local` and fill in from Supabase → Project Settings → API.
#
# Both values are public by design: the anon key is meant to ship in the
# client, and Row Level Security in supabase/schema.sql is what actually
# constrains what it can do. Never put the SERVICE ROLE key here.
#
# Leave these unset and the app runs exactly as before — local to one
# device, with booking disabled across phones.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
