# Copy to `.env.local`, or paste these into Vercel → Settings → Environment
# Variables. Values come from Firebase console → Project settings → General →
# "Your apps" → Web app config.
#
# These are PUBLIC by design: a Firebase web config always ships in the
# client. What constrains it is firebase/database.rules.json, not secrecy.
# Never put a service-account key here.
#
# Leave them unset and the app runs exactly as before — local to one device,
# with no cross-phone sync. Useful for offline demos.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
