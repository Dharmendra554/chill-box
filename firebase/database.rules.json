// Chill-Box security rules. Paste into Firebase console -> Realtime Database -> Rules.
//
// No skipper ever logs in - the app signs each phone in anonymously behind
// the scenes - so these rules are the only thing standing between a public
// web config and the harbour's data. They constrain SHAPE and IDENTITY,
// which is what rules can do well:
//
//   * every write needs a signed-in identity. The app signs each phone in
//     anonymously, so nothing changes for the skipper, but the public web
//     config on its own no longer grants anyone write access
//   * anyone may read - the boxes are public information, that is the point
//   * a slot must always be a well-formed slot: a known status, a slot index
//     in range, and a boat that actually exists at that harbour
//   * a write that replaces the boxes must carry all three boxes, each with
//     its ten slots, so the shape of the harbour survives - but see below:
//     this does NOT stop a signed-in client emptying every one of them
//   * only the last four digits of a mobile number are ever stored here, and
//     they cannot be rewritten once set. No boat can be deleted, because
//     slots point at boats
//   * a ledger row, once written, can never be edited or deleted
//
// BE CLEAR ABOUT WHAT THIS IS NOT. These rules check the SHAPE of the data
// and that the writer is signed in. They are not harbour policy, and a
// signed-in client that ignores the app can still:
//
//   * EMPTY THE WHOLE HARBOUR in one perfectly valid write: three boxes of
//     ten empty slots passes every rule here. Every live hold and stored
//     crate, on every phone, gone. This is the biggest thing these rules do
//     not stop, and per-slot writes are what would stop it
//   * overwrite a slot belonging to another boat - booking transacts over the
//     whole 'boxes' node, so write is granted there rather than per slot
//   * delete an individual slot. Write cascades from 'boxes', and a validate
//     rule does not run on a delete, so the ten-slot check above cannot see
//     it. The reader backfills the gap as empty, so a crate would vanish
//     quietly. Per-slot writes would close this too
//   * append invented ledger rows. Rows cannot be edited, but the report can
//     be padded by addition, which for a society billing off the CSV is the
//     same problem
//   * rewrite another boat's name or owner, and set its own status to
//     'active' - there is no admin identity to check against
//   * exceed the 2-crate cap, which no rule can count across three boxes
//
// All of those run in the client (lib/harbourSync.ts) inside a transaction,
// which makes them correct against two honest boats racing - the case that
// actually happens on a dock - and not against a determined attacker.
// Closing them means binding each slot to its boat's uid, which needs the
// booking path rewritten as per-slot writes. See README, 'What this cannot
// do yet'. The last four digits are also world-readable, so they identify a
// boat; they do not authenticate one.
{
  "rules": {
    ".read": true,
    ".write": false,

    "harbours": {
      "$harbour": {
        "boxes": {
          ".read": true,
          // NO write permission here, deliberately. It is granted one level
          // down, on the slot — which is the whole point. A rule that can
          // write this node can write every slot in it, and cannot tell your
          // crate from mine.

          // A typo, or a client inventing 'box9' or slot 47, is refused
          // rather than quietly stored.
          "$box": {
            ".validate": "$box.matches(/^box[1-3]$/)",

            "$slot": {
              // Who may move this crate. Three questions:
              //
              //   1. any boat I name in the new slot must be mine
              //   2. any boat already in the slot must be mine, unless
              //   3. the harbour has given up on it — a hold that ran out, or
              //      a crate already flagged as an overstay
              //
              // "Mine" means the boat carries this device's uid. A boat that
              // no device has claimed is open to anyone: that is the seeded
              // demo roster, and it is what keeps Publish harbour and Reset
              // demo working. The moment a skipper claims a boat, only their
              // phone can move its crates — including the harbour master's.
              //
              // 14400000 is the 4-hour hold in ms; it must match HOLD_MS in
              // src/lib/time.ts.
              ".write": "auth != null && (!newData.exists() || !newData.hasChild('boatId') || !root.child('harbours').child($harbour).child('boats').child(newData.child('boatId').val()).child('uid').exists() || root.child('harbours').child($harbour).child('boats').child(newData.child('boatId').val()).child('uid').val() === auth.uid) && (!data.exists() || !data.hasChild('boatId') || !root.child('harbours').child($harbour).child('boats').child(data.child('boatId').val()).child('uid').exists() || root.child('harbours').child($harbour).child('boats').child(data.child('boatId').val()).child('uid').val() === auth.uid || data.child('status').val() === 'overstay' || (data.child('status').val() === 'reserved' && data.child('reservedAt').val() + 14400000 <= now))",
              ".validate": "$slot.matches(/^[0-9]$/) && newData.hasChildren(['status'])",
              "status": {
                ".validate": "newData.isString() && (newData.val() === 'empty' || newData.val() === 'reserved' || newData.val() === 'occupied' || newData.val() === 'overstay')"
              },
              "boatId": {
                ".validate": "newData.val() === null || root.child('harbours').child($harbour).child('boats').child(newData.val()).exists()"
              },
              "species": { ".validate": "newData.val() === null || newData.isString()" },
              "reservedAt": { ".validate": "newData.val() === null || newData.isNumber()" },
              "depositedAt": { ".validate": "newData.val() === null || newData.isNumber()" },
              "plannedOutAt": { ".validate": "newData.val() === null || newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },

        "boats": {
          ".read": true,
          "$boat": {
            // Never deletable: slots point at boats, and a deleted boat would
            // orphan whatever it is holding. Rejection is a local matter.
            //
            // And a write may never drop or change an existing `uid`. Without
            // that clause, replacing the boat object without a uid would
            // silently unclaim it — and the finder could then claim it and
            // move that skipper's crates.
            ".write": "auth != null && newData.exists() && (!data.hasChild('uid') || newData.child('uid').val() === data.child('uid').val())",
            ".validate": "newData.hasChildren(['name', 'owner', 'mobileLast4', 'status', 'registeredAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
            "nameTe": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
            "owner": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
            // Four digits, never the whole number: this node is world-readable
            // so any phone can name the boat holding a crate, and publishing
            // twenty fishermen's mobile numbers is a breach with no upside.
            // Immutable, because those digits are what proves you own a boat.
            "mobileLast4": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/) && (!data.exists() || newData.val() === data.val())" },
            // Any of the three, including on create. Forcing new boats to
            // 'pending' would look like enforcement and be none: with no
            // admin identity, the same client could flip it a moment later.
            "status": { ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'active' || newData.val() === 'blocked')" },
            // Not immutable, deliberately: the seeded roster gets its dates
            // from whichever phone seeded it, so pinning them here would make
            // a second phone's publish fail on every boat.
            "registeredAt": { ".validate": "newData.isNumber()" },
            // The device that holds this boat. First claim wins and it can
            // never be reassigned — this is the only thing that makes the
            // slot rules above mean anything, so it must not be something a
            // second phone can simply overwrite. It can only ever be your own
            // uid, so nobody can hand a boat to someone else either.
            "uid": {
              ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === data.val())"
            },
            "$other": { ".validate": false }
          }
        },

        // Append-only: each row is writable once, never edited or deleted.
        "ledger": {
          ".read": true,
          // Phones follow the newest rows by release time. Without this index
          // Firebase would sort them on the client, which means downloading
          // the whole history to every phone on the 2G target.
          ".indexOn": ["releasedAt"],
          "$entry": {
            ".write": "auth != null && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['boatId', 'boxId', 'crates', 'depositedAt', 'releasedAt'])",
            "boatId": { ".validate": "newData.isString()" },
            "boxId": { ".validate": "newData.isString()" },
            "crates": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 2" },
            "species": { ".validate": "newData.val() === null || newData.isString()" },
            "depositedAt": { ".validate": "newData.isNumber()" },
            "releasedAt": { ".validate": "newData.isNumber()" },
            "overstay": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
